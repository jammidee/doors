/* DOORS system call numbers, generated from OSSOURCE/MPUBLICS.ASM (MMURTL call gates).
   Number = (gate selector - 40h) / 8, so the order and numbering are exactly MMURTL's.
   Used as an X-macro: #define X(num, name) ...  #include <doors/syscalls.def>
   Regenerate with tools/gen_syscalls.sh; never renumber. */
X(  0, WaitMsg)
X(  1, SendMsg)
X(  2, ISendMsg)
X(  3, SetPriority)
X(  4, Request)
X(  5, Respond)
X(  6, CheckMsg)
X(  7, NewTask)
